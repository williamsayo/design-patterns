<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootView" alignment="TOP_CENTER" minHeight="480" minWidth="360" prefHeight="600" prefWidth="440" styleClass="root-pane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.mediator.ui.ChatController">

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
            <HBox.margin><Insets bottom="0" left="0" right="0" top="0" /></HBox.margin>

            <!-- Username — injected programmatically after load -->
            <Label fx:id="usernameLabel" styleClass="header-username" text="USERNAME" />

            <!-- Online badge -->
            <HBox alignment="CENTER" spacing="5" styleClass="online-badge">
                <Label styleClass="badge-dot" text="●" />
                <Label styleClass="badge-text" text="ONLINE" />
            </HBox>

            <padding><Insets bottom="14" left="18" right="18" top="14" /></padding>
        </HBox>

        <ScrollPane fx:id="messageScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="message-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">

            <TextArea fx:id="messageArea" editable="false" prefRowCount="20" styleClass="message-area" wrapText="true" VBox.vgrow="ALWAYS" />
        </ScrollPane>

        <VBox spacing="10" styleClass="footer-pane">
            <padding><Insets bottom="16" left="18" right="18" top="12" /></padding>

            <!-- Row 1: Recipient selector -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="field-label" text="To:" />
                <ComboBox fx:id="recipientBox" maxWidth="Infinity" promptText="select recipient" styleClass="recipient-combo" />
            </HBox>

            <!-- Row 2: Message input + Send button -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="messageField" promptText="type a message…" styleClass="message-input" HBox.hgrow="ALWAYS" />

                <Button fx:id="sendButton" defaultButton="true" onAction="#handleSend" styleClass="send-button" text="SEND" />
            </HBox>
        </VBox>
</VBox>
